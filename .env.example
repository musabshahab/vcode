# Optional: Codenine Connect against your own relay and Clerk instance.
# Builds leave Connect off until these are set. Do not add server-side secrets to
# this file.

# Your Clerk instance. Get these from the Clerk Dashboard under API keys, JWT
# templates, and OAuth applications.
# CODENINE_CLERK_PUBLISHABLE_KEY=
# CODENINE_CLERK_JWT_TEMPLATE=
# CODENINE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CODENINE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# CODENINE_APPLE_TEAM_ID=ABC1234567
# CODENINE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/codenine.provisionprofile
# CODENINE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your relay. `infra/relay` deploys update it automatically.
# CODENINE_RELAY_URL=

# Optional: your hosted web app origin, for the CLI's out-of-band OAuth flow and
# hosted pairing links.
# CODENINE_HOSTED_APP_URL=
